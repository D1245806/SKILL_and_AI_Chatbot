# 複製此檔案為 .env 並填入你的金鑰
# Windows: copy .env.example .env
# Mac/Linux: cp .env.example .env

# Google Gemini API
GEMINI_API_KEY=

# LINE Bot 設定
# LINE_CHANNEL_ACCESS_TOKEN：至 LINE Developers Console → Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET：至 LINE Developers Console → Basic settings → Channel secret
LINE_CHANNEL_SECRET=
